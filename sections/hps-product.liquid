<product-info
  id="MainProduct-{{ section.id }}"
  data-section="{{ section.id }}"
  data-product-id="{{ product.id }}"
  data-update-url="true"
  data-url="{{ product.url }}"
>
  {{- 'hps-product.css' | asset_url | stylesheet_tag -}}
  {{- 'component-price.css' | asset_url | stylesheet_tag -}}
  {{- 'component-rating.css' | asset_url | stylesheet_tag -}}

  {%- unless product.has_only_default_variant -%}
    {{- 'component-product-variant-picker.css' | asset_url | stylesheet_tag -}}
    {{- 'component-swatch-input.css' | asset_url | stylesheet_tag -}}
    {{- 'component-swatch.css' | asset_url | stylesheet_tag -}}
  {%- endunless -%}

  {%- style -%}
    #MainProduct-{{ section.id }} { padding-top: 0; padding-bottom: 0; }
  {%- endstyle -%}

  <script src="{{ 'hps-atc-feedback.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'product-info.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>

  {%- if request.design_mode -%}
    <script src="{{ 'theme-editor.js' | asset_url }}" defer="defer"></script>
  {%- endif -%}

  {%- assign product_form_id = 'product-form-' | append: section.id -%}

  <cart-notification id="cart-notification" aria-hidden="true" style="display:none"></cart-notification>

  <div class="hps-product-wrap">

    <!-- ── Gallery (col 1): main image + thumbnails below ── -->
    <div class="hps-gallery">

      <div class="hps-gallery__main">
        {%- for image in product.images -%}
          {%- if forloop.first -%}{%- assign img_loading = 'eager' -%}{%- else -%}{%- assign img_loading = 'lazy' -%}{%- endif -%}
          <div class="hps-gallery__slide{% if forloop.first %} is-active{% endif %}" data-index="{{ forloop.index0 }}">
            {{
              image
              | image_url: width: 1800
              | image_tag:
                loading: img_loading,
                alt: image.alt | default: product.title,
                widths: '900, 1200, 1800',
                class: 'hps-gallery__img',
                width: nil,
                height: nil
            }}
          </div>
        {%- endfor -%}
      </div>

      <div class="hps-gallery__thumbs">
        {%- for image in product.images -%}
          <button
            class="hps-gallery__thumb{% if forloop.first %} is-active{% endif %}"
            data-index="{{ forloop.index0 }}"
            aria-label="{{ image.alt | default: product.title }}"
          >
            {{
              image
              | image_url: width: 160
              | image_tag:
                loading: 'lazy',
                alt: image.alt | default: product.title,
                widths: '80, 120, 160'
            }}
          </button>
        {%- endfor -%}
      </div>

    </div>

    <script>
      document.addEventListener('DOMContentLoaded', function () {
        var wrap = document.querySelector('.hps-product-wrap');
        if (!wrap) return;

        wrap.querySelectorAll('.hps-gallery__thumb').forEach(function (thumb) {
          thumb.addEventListener('click', function () {
            var idx = this.dataset.index;
            wrap.querySelectorAll('.hps-gallery__thumb').forEach(function (t) { t.classList.remove('is-active'); });
            wrap.querySelectorAll('.hps-gallery__slide').forEach(function (s) { s.classList.remove('is-active'); });
            this.classList.add('is-active');
            wrap.querySelector('.hps-gallery__slide[data-index="' + idx + '"]').classList.add('is-active');
          });
        });

        wrap.querySelectorAll('.hps-gallery__slide').forEach(function (slide) {
          var img = slide.querySelector('.hps-gallery__img, img');
          if (!img) return;

          slide.addEventListener('mouseenter', function () {
            slide.classList.add('is-zooming');
          });

          slide.addEventListener('mouseleave', function () {
            slide.classList.remove('is-zooming');
            img.style.transformOrigin = 'center center';
          });

          slide.addEventListener('mousemove', function (e) {
            var rect = slide.getBoundingClientRect();
            var x = ((e.clientX - rect.left) / rect.width) * 100;
            var y = ((e.clientY - rect.top) / rect.height) * 100;
            img.style.transformOrigin = x + '% ' + y + '%';
          });
        });
      });
    </script>

    <!-- ── Info column (col 3) ── -->
    <section id="ProductInfo-{{ section.id }}" class="hps-product-info">

      {%- for block in section.blocks -%}
        {%- case block.type -%}

          {%- when 'title' -%}
            <h1 class="hps-product__title" {{ block.shopify_attributes }}>
              {{- product.title | escape -}}
            </h1>

          {%- when 'description' -%}
            {%- if product.description != blank -%}
              <div class="hps-product__description rte" {{ block.shopify_attributes }}>
                {{ product.description }}
              </div>
            {%- endif -%}

          {%- when 'price' -%}
            <div id="price-{{ section.id }}" class="hps-product__price" role="status" {{ block.shopify_attributes }}>
              {%- render 'price',
                product: product,
                use_variant: true,
                show_badges: false,
                price_class: 'price--large'
              -%}
            </div>

          {%- when 'variant_picker' -%}
            {%- assign variant_block = block -%}

          {%- when 'buy_buttons' -%}
            <div class="hps-product__actions-row">
              {%- if variant_block -%}
                <div class="hps-product__actions-picker">
                  {%- render 'product-variant-picker',
                    product: product,
                    block: variant_block,
                    product_form_id: product_form_id
                  -%}
                </div>
              {%- endif -%}
              <div class="hps-product__actions-buy">
                {%- render 'buy-buttons',
                  block: block,
                  product: product,
                  product_form_id: product_form_id,
                  section_id: section.id,
                  show_pickup_availability: false
                -%}
              </div>
            </div>

          {%- when 'product_info_popup' -%}
            {%- assign mf_material = block.settings.material -%}
            {%- assign mf_fit = block.settings.fit -%}
            {%- assign mf_care = product.metafields.custom.care_instructions_main -%}
            {%- style -%}
              #hps-info-wrap-{{ block.id }} {
                --hps-info-btn-color:  {{ block.settings.btn_color | default: '#000000' }};
                --hps-info-dialog-bg:  {{ block.settings.dialog_bg | default: '#ffffff' }};
                --hps-info-dialog-fg:  {{ block.settings.dialog_color | default: '#000000' }};
                --hps-info-margin-top: {{ block.settings.margin_top | default: 12 }}px;
                --hps-info-margin-bot: {{ block.settings.margin_bottom | default: 0 }}px;
              }
            {%- endstyle -%}
            <div id="hps-info-wrap-{{ block.id }}" {{ block.shopify_attributes }}>
              <button
                class="hps-info-btn"
                aria-haspopup="dialog"
                onclick="document.getElementById('hps-info-dialog-{{ block.id }}').showModal()"
              >
                Product information
              </button>
              <dialog id="hps-info-dialog-{{ block.id }}" class="hps-info-dialog">
                <button class="hps-info-dialog__close" onclick="this.closest('dialog').close()" aria-label="Close">&#x2715;</button>
                <div class="hps-info-dialog__content">
                  {%- if mf_material != blank -%}
                    <div class="hps-info-row">
                      <span class="hps-info-label">Material</span>
                      <span class="hps-info-value">{{ mf_material }}</span>
                    </div>
                  {%- endif -%}
                  {%- if mf_fit != blank -%}
                    <div class="hps-info-row">
                      <span class="hps-info-label">Fit</span>
                      <span class="hps-info-value">{{ mf_fit }}</span>
                    </div>
                  {%- endif -%}
                  {%- if mf_care != blank -%}
                    <div class="hps-info-row">
                      <span class="hps-info-label">Care</span>
                      <span class="hps-info-value">{{ mf_care | newline_to_br }}</span>
                    </div>
                  {%- endif -%}
                </div>
              </dialog>
              <script>
                (function () {
                  var dialog = document.getElementById('hps-info-dialog-{{ block.id }}');
                  if (!dialog) return;
                  dialog.addEventListener('click', function (e) {
                    if (e.target === dialog) dialog.close();
                  });
                })();
              </script>
            </div>

        {%- endcase -%}
      {%- endfor -%}

    </section>

  </div>

{% stylesheet %}
  .hps-info-btn {
    background: transparent;
    border: none;
    color: var(--hps-info-btn-color, #000);
    font-family: 'Courier New', monospace;
    font-size: 0.9375rem;
    padding: 0.5rem 0;
    cursor: pointer;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    width: 100%;
    text-align: left;
    margin-top: var(--hps-info-margin-top, 12px);
    margin-bottom: var(--hps-info-margin-bot, 0px);
  }
  .hps-info-btn:hover {
    opacity: 0.55;
  }
  .hps-info-dialog {
    border: 1px solid var(--hps-info-dialog-fg, #000);
    background: var(--hps-info-dialog-bg, #fff);
    color: var(--hps-info-dialog-fg, #000);
    font-family: 'Courier New', monospace;
    padding: 2rem;
    max-width: 480px;
    width: 90vw;
    position: relative;
  }
  .hps-info-dialog::backdrop {
    background: rgba(0, 0, 0, 0.45);
  }
  .hps-info-dialog__close {
    background: none;
    border: none;
    cursor: pointer;
    font-size: 1.25rem;
    position: absolute;
    top: 1rem;
    right: 1rem;
    line-height: 1;
    font-family: inherit;
    color: var(--hps-info-dialog-fg, #000);
    padding: 0;
  }
  .hps-info-dialog__close:hover {
    opacity: 0.5;
  }
  .hps-info-dialog__content {
    margin-top: 1.5rem;
  }
  .hps-info-row {
    display: grid;
    grid-template-columns: 5.5rem 1fr;
    gap: 0.75rem;
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--hps-info-dialog-fg, #000);
  }
  .hps-info-row:last-child {
    border-bottom: none;
  }
  .hps-info-label {
    text-transform: uppercase;
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    opacity: 0.55;
    align-self: start;
    padding-top: 0.1em;
  }
  .hps-info-value {
    font-size: 0.8125rem;
    line-height: 1.5;
  }
{% endstylesheet %}

</product-info>

{% schema %}
{
  "name": "HPS Product",
  "tag": "section",
  "settings": [
    {
      "type": "select",
      "id": "gallery_layout",
      "label": "Gallery layout",
      "default": "thumbnail_slider",
      "options": [
        { "value": "stacked",          "label": "Stacked" },
        { "value": "thumbnail_slider", "label": "Thumbnail slider" },
        { "value": "thumbnail",        "label": "Thumbnails below" }
      ]
    },
    {
      "type": "select",
      "id": "media_size",
      "label": "Image size",
      "default": "large",
      "options": [
        { "value": "small",  "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large",  "label": "Large" }
      ]
    },
    {
      "type": "select",
      "id": "mobile_thumbnails",
      "label": "Mobile thumbnails",
      "default": "hide",
      "options": [
        { "value": "show",    "label": "Show" },
        { "value": "hide",    "label": "Hide" },
        { "value": "columns", "label": "Columns" }
      ]
    },
    {
      "type": "checkbox",
      "id": "hide_variants",
      "label": "Hide variant media",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_video_looping",
      "label": "Loop videos",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "enable_sticky_info",
      "label": "Sticky info panel",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "title",
      "name": "Title",
      "limit": 1
    },
    {
      "type": "description",
      "name": "Description",
      "limit": 1
    },
    {
      "type": "price",
      "name": "Price",
      "limit": 1
    },
    {
      "type": "variant_picker",
      "name": "Variant picker",
      "limit": 1,
      "settings": [
        {
          "type": "select",
          "id": "picker_type",
          "label": "Type",
          "default": "dropdown",
          "options": [
            { "value": "dropdown", "label": "Dropdown" },
            { "value": "button",   "label": "Pills" }
          ]
        }
      ]
    },
    {
      "type": "buy_buttons",
      "name": "Buy buttons",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_dynamic_checkout",
          "label": "Show dynamic checkout button",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "show_gift_card_recipient",
          "label": "Show gift card recipient form",
          "default": false
        }
      ]
    },
    {
      "type": "product_info_popup",
      "name": "Product info popup",
      "limit": 1,
      "settings": [
        {
          "type": "header",
          "content": "Content"
        },
        {
          "type": "text",
          "id": "material",
          "label": "Material"
        },
        {
          "type": "text",
          "id": "fit",
          "label": "Fit"
        },
        {
          "type": "header",
          "content": "Button"
        },
        {
          "type": "color",
          "id": "btn_color",
          "label": "Text color",
          "default": "#000000"
        },
        {
          "type": "header",
          "content": "Popup"
        },
        {
          "type": "color",
          "id": "dialog_bg",
          "label": "Background",
          "default": "#ffffff"
        },
        {
          "type": "color",
          "id": "dialog_color",
          "label": "Text",
          "default": "#000000"
        },
        {
          "type": "header",
          "content": "Spacing"
        },
        {
          "type": "range",
          "id": "margin_top",
          "label": "Top margin",
          "min": 0,
          "max": 60,
          "step": 4,
          "unit": "px",
          "default": 12
        },
        {
          "type": "range",
          "id": "margin_bottom",
          "label": "Bottom margin",
          "min": 0,
          "max": 60,
          "step": 4,
          "unit": "px",
          "default": 0
        }
      ]
    }
  ],
  "presets": [
    { "name": "HPS Product" }
  ]
}
{% endschema %}
