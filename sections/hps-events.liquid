{%- style -%}
  #hps-events-{{ section.id }} {
    --hps-events-bg: {{ section.settings.bg_color | default: '#ffffff' }};
    --hps-events-fg: {{ section.settings.text_color | default: '#000000' }};
    --hps-events-padding-top: {{ section.settings.padding_top | default: 64 }}px;
    --hps-events-padding-bottom: {{ section.settings.padding_bottom | default: 64 }}px;
  }
{%- endstyle -%}

<section id="hps-events-{{ section.id }}" class="hps-events">
  <div class="hps-events__wrap">
    {%- if section.settings.heading != blank -%}
      <h2 class="hps-events__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <hr class="hps-events__rule">
      {%- assign max = section.settings.max_events -%}
      {%- for block in section.blocks -%}
        {%- if max > 0 and forloop.index > max -%}
          {%- break -%}
        {%- endif -%}
        {%- case block.type -%}
          {%- when 'event' -%}
            {%- assign status = block.settings.status | default: 'upcoming' -%}
            <article
              class="hps-events__row hps-events__row--{{ status }}"
              {{ block.shopify_attributes }}
            >
              <div class="hps-events__date">
                {{ block.settings.date | default: 'tba' }}
                {%- if block.settings.time != blank -%}
                  <small>{{ block.settings.time }}</small>
                {%- endif -%}
              </div>

              <div class="hps-events__body">
                {%- if block.settings.location != blank -%}
                  <p class="hps-events__loc">{{ block.settings.location | downcase }}</p>
                {%- endif -%}
                <h3 class="hps-events__title">
                  {{ block.settings.title | default: 'untitled event' | downcase }}
                  {%- if status == 'cancelled' -%}
                    <span class="hps-events__tag"> · cancelled</span>
                  {%- endif -%}
                </h3>
                {%- if block.settings.description != blank -%}
                  <div class="hps-events__desc">{{ block.settings.description }}</div>
                {%- endif -%}
              </div>

              <div class="hps-events__cta">
                {%- if status == 'upcoming' and block.settings.cta_url != blank -%}
                  <a href="{{ block.settings.cta_url }}">
                    {{- block.settings.cta_label | default: 'rsvp' | downcase }} &rarr;
                  </a>
                {%- endif -%}
              </div>
            </article>
        {%- endcase -%}
      {%- endfor -%}
    {%- else -%}
      <div class="hps-events__empty">
        {{ section.settings.empty_text | default: 'no events scheduled' }}
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .hps-events {
    background: var(--hps-events-bg);
    color: var(--hps-events-fg);
    padding: var(--hps-events-padding-top) 24px var(--hps-events-padding-bottom);
    font-family: 'Courier New', Courier, monospace;
  }

  .hps-events__wrap {
    max-width: 1000px;
    margin: 0 auto;
  }

  .hps-events__heading {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin: 0 0 20px;
  }

  .hps-events__rule {
    border: none;
    border-top: 1px dashed currentColor;
    margin: 0;
    opacity: 0.9;
  }

  .hps-events__row {
    display: grid;
    grid-template-columns: 180px 1fr 160px;
    gap: 32px;
    padding: 16px 0;
    align-items: start;
    font-size: 11px;
    line-height: 1.5;
    border-top: 1px dashed currentColor;
  }

  .hps-events__row:first-of-type {
    border-top: none;
  }

  .hps-events__date {
    font-weight: 700;
    text-transform: lowercase;
    letter-spacing: 0.02em;
  }

  .hps-events__date small {
    display: block;
    font-weight: 400;
    opacity: 0.6;
    font-size: 10px;
    padding-top: 2px;
  }

  .hps-events__body {
    min-width: 0;
  }

  .hps-events__loc {
    font-size: 10px;
    opacity: 0.6;
    text-transform: lowercase;
    margin: 0 0 4px;
  }

  .hps-events__title {
    margin: 0 0 6px;
    font-size: 12px;
    font-weight: 700;
    text-transform: lowercase;
    letter-spacing: 0.02em;
  }

  .hps-events__tag {
    font-weight: 400;
    color: #c03f2b;
    text-transform: lowercase;
  }

  .hps-events__desc {
    font-size: 10px;
    opacity: 0.8;
    line-height: 1.6;
  }

  .hps-events__desc p {
    margin: 0 0 6px;
  }

  .hps-events__desc p:last-child {
    margin-bottom: 0;
  }

  .hps-events__cta {
    display: flex;
    justify-content: flex-end;
    align-items: flex-start;
  }

  .hps-events__cta a {
    display: inline-block;
    font-size: 10px;
    font-weight: 700;
    text-transform: lowercase;
    padding: 6px 12px;
    color: currentColor;
    border: 1px solid currentColor;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color 0.15s ease, color 0.15s ease;
  }

  .hps-events__cta a:hover,
  .hps-events__cta a:focus-visible {
    background: #6b7c3f;
    color: #ffffff;
    border-color: #6b7c3f;
    outline: none;
  }

  .hps-events__row--past { opacity: 0.45; }

  .hps-events__empty {
    text-align: center;
    padding: 40px 0;
    font-size: 11px;
    color: currentColor;
    opacity: 0.55;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    border-top: 1px dashed currentColor;
    border-bottom: 1px dashed currentColor;
  }

  @media screen and (max-width: 749px) {
    .hps-events__row {
      grid-template-columns: 1fr;
      gap: 10px;
      padding: 20px 0;
    }

    .hps-events__cta {
      justify-content: flex-start;
    }

    .hps-events__cta a {
      width: 100%;
      text-align: center;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "HPS Events",
  "tag": "section",
  "class": "hps-events-section",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Events"
    },
    {
      "type": "text",
      "id": "empty_text",
      "label": "Empty-state text",
      "info": "Shown when no event blocks are added.",
      "default": "no events scheduled"
    },
    {
      "type": "range",
      "id": "max_events",
      "label": "Max events to show",
      "info": "0 = show all.",
      "min": 0,
      "max": 50,
      "step": 1,
      "default": 0
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "default": 64,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "default": 64,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#000000"
    }
  ],
  "blocks": [
    {
      "type": "event",
      "name": "Event",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Event title"
        },
        {
          "type": "text",
          "id": "date",
          "label": "Date",
          "info": "Free text so you can write single dates, ranges, or 'TBA'.",
          "default": "Sat 14 Jun 2026"
        },
        {
          "type": "text",
          "id": "time",
          "label": "Time",
          "default": "19:00"
        },
        {
          "type": "text",
          "id": "location",
          "label": "Location",
          "default": "Roskilde, DK"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Description"
        },
        {
          "type": "select",
          "id": "status",
          "label": "Status",
          "options": [
            { "value": "upcoming",  "label": "Upcoming" },
            { "value": "past",      "label": "Past" },
            { "value": "cancelled", "label": "Cancelled" }
          ],
          "default": "upcoming"
        },
        {
          "type": "header",
          "content": "Call to action"
        },
        {
          "type": "text",
          "id": "cta_label",
          "label": "Button label",
          "default": "rsvp"
        },
        {
          "type": "url",
          "id": "cta_url",
          "label": "Button URL"
        }
      ]
    }
  ],
  "max_blocks": 50,
  "presets": [
    {
      "name": "HPS Events",
      "blocks": [
        { "type": "event" },
        { "type": "event" }
      ]
    }
  ]
}
{% endschema %}
