{{ 'hps-cart.css' | asset_url | stylesheet_tag }}

{%- if cart == empty -%}

  <div class="hps-cart-page">
    <div class="hps-cart-box">
      <div class="hps-cart-box__header">cart</div>
      <div class="hps-cart-box__empty">your cart is empty.</div>
      <div class="hps-cart-box__footer">
        <span></span>
        <div class="hps-cart-box__btns">
          <a href="{{ routes.collections_url }}/all" class="hps-cart-page-btn hps-cart-page-btn--secondary">keep shopping</a>
        </div>
      </div>
    </div>
  </div>

{%- else -%}

  <div class="hps-cart-page">
    <div class="hps-cart-box">
      <div class="hps-cart-box__header">cart</div>
      <div class="hps-cart-box__count">{{ cart.item_count }} item{% if cart.item_count != 1 %}s{% endif %} in your cart.</div>

      <div class="hps-cart-items">
        {%- for item in cart.items -%}
          <div class="hps-cart-item" data-line="{{ forloop.index }}">
            {%- if item.image -%}
              <a href="{{ item.url }}" class="hps-cart-item__img-wrap">
                <img
                  src="{{ item.image | image_url: width: 160 }}"
                  alt="{{ item.image.alt | escape }}"
                  width="80"
                  height="80"
                  class="hps-cart-item__img"
                  loading="lazy"
                >
              </a>
            {%- endif -%}

            <div class="hps-cart-item__info">
              <a href="{{ item.url }}" class="hps-cart-item__title">{{ item.product.title }}</a>
              {%- for option in item.options_with_values -%}
                <span class="hps-cart-item__variant">{{ option.name | downcase }}: {{ option.value | downcase }}</span>
              {%- endfor -%}
            </div>

            <div class="hps-cart-item__controls">
              <div class="hps-qty" data-line="{{ forloop.index }}">
                <button type="button" class="hps-qty__btn" data-action="decrement" aria-label="Decrease quantity">−</button>
                <input
                  type="number"
                  class="hps-qty__input"
                  value="{{ item.quantity }}"
                  min="0"
                  step="1"
                  inputmode="numeric"
                  pattern="[0-9]*"
                  aria-label="Quantity"
                >
                <button type="button" class="hps-qty__btn" data-action="increment" aria-label="Increase quantity">+</button>
              </div>
              <button type="button" class="hps-cart-item__remove" data-line="{{ forloop.index }}">remove</button>
            </div>

            <div class="hps-cart-item__price">{{ item.final_line_price | money }}</div>
          </div>
        {%- endfor -%}
      </div>

      <script>
        (function () {
          var items = document.querySelectorAll('.hps-cart-item');
          function changeLine(line, quantity) {
            document.body.classList.add('hps-cart-updating');
            return fetch('{{ routes.cart_change_url }}.js', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
              body: JSON.stringify({ line: parseInt(line, 10), quantity: quantity })
            }).then(function () {
              window.location.reload();
            }).catch(function () {
              document.body.classList.remove('hps-cart-updating');
            });
          }

          items.forEach(function (item) {
            var line = item.dataset.line;
            var input = item.querySelector('.hps-qty__input');
            var dec = item.querySelector('[data-action="decrement"]');
            var inc = item.querySelector('[data-action="increment"]');
            var remove = item.querySelector('.hps-cart-item__remove');

            dec.addEventListener('click', function () {
              var next = Math.max(0, parseInt(input.value, 10) - 1);
              input.value = next;
              changeLine(line, next);
            });
            inc.addEventListener('click', function () {
              var next = (parseInt(input.value, 10) || 0) + 1;
              input.value = next;
              changeLine(line, next);
            });
            input.addEventListener('change', function () {
              var next = Math.max(0, parseInt(input.value, 10) || 0);
              input.value = next;
              changeLine(line, next);
            });
            remove.addEventListener('click', function () {
              changeLine(line, 0);
            });
          });
        })();
      </script>

      <div class="hps-cart-box__subtotal">subtotal: {{ cart.total_price | money }}</div>

      <div class="hps-cart-box__footer">
        {%- if section.settings.shipping_note != blank -%}
          <span class="hps-cart-box__shipping">{{ section.settings.shipping_note }}</span>
        {%- else -%}
          <span></span>
        {%- endif -%}
        <div class="hps-cart-box__btns">
          <a href="{{ routes.collections_url }}/all" class="hps-cart-page-btn hps-cart-page-btn--secondary">keep shopping</a>
          <a href="{{ routes.checkout_url }}" class="hps-cart-page-btn hps-cart-page-btn--primary">checkout now</a>
        </div>
      </div>
    </div>
  </div>

{%- endif -%}

{% schema %}
{
  "name": "HPS Cart",
  "settings": [
    {
      "type": "text",
      "id": "shipping_note",
      "label": "Shipping note",
      "default": "* free shipping on all orders over \u20ac250, some exceptions may apply"
    }
  ]
}
{% endschema %}
