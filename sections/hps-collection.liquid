{%- style -%}
  :root {
    --hps-content-top-gap: {{ section.settings.content_top_gap }}px;
    --hps-nav-grid-gap: {{ section.settings.nav_grid_gap }}px;
  }
{%- endstyle -%}

{%- if section.settings.show_collection_title and collection.title != blank -%}
  <h1 class="hps-collection-title">{{ collection.title }}</h1>
{%- endif -%}

<div
  class="hps-grid"
  style="--hps-cols: {{ section.settings.grid_columns_desktop }};"
>
  {%- paginate collection.products by section.settings.products_per_page -%}
    {%- for product in collection.products -%}
      <a href="{{ product.url }}" class="hps-product-card">
        <div class="hps-product-card__media">
          {%- if product.featured_image != blank -%}
            {{
              product.featured_image
              | image_url: width: 600
              | image_tag:
                loading: 'lazy',
                alt: product.title,
                widths: '300, 400, 600, 800',
                class: 'hps-product-card__img'
            }}
          {%- else -%}
            <div class="hps-product-card__img" style="background:#1a1a1a;"></div>
          {%- endif -%}
          {%- if product.tags contains 'new' -%}
            <span class="hps-product-card__badge">new</span>
          {%- endif -%}
          <div class="hps-product-card__overlay" aria-hidden="true">
            <span class="hps-product-card__title">{{ product.title }}</span>
            <span class="hps-product-card__price">
              {{- product.price | money -}}
            </span>
          </div>
        </div>
        <div class="hps-product-card__info">
          <span class="hps-product-card__info-title">{{ product.title }}</span>
          {%- if product.available -%}
            <span class="hps-product-card__info-price">{{ product.price | money }}</span>
          {%- else -%}
            <span class="hps-product-card__info-soldout">sold out</span>
          {%- endif -%}
        </div>
      </a>
    {%- endfor -%}
  {%- endpaginate -%}
</div>

{% schema %}
{
  "name": "HPS Collection",
  "tag": "section",
  "class": "hps-collection-section",
  "settings": [
    {
      "type": "header",
      "content": "Layout spacing"
    },
    {
      "type": "range",
      "id": "content_top_gap",
      "min": 0,
      "max": 64,
      "step": 4,
      "default": 0,
      "unit": "px",
      "label": "Gap below logo bar"
    },
    {
      "type": "range",
      "id": "nav_grid_gap",
      "min": 8,
      "max": 80,
      "step": 4,
      "default": 24,
      "unit": "px",
      "label": "Gap between nav and grid"
    },
    {
      "type": "header",
      "content": "Product grid"
    },
    {
      "type": "checkbox",
      "id": "show_collection_title",
      "default": true,
      "label": "Show collection title"
    },
    {
      "type": "range",
      "id": "grid_columns_desktop",
      "min": 3,
      "max": 8,
      "step": 1,
      "default": 5,
      "label": "Columns — fewer = larger items, more = smaller"
    },
    {
      "type": "range",
      "id": "products_per_page",
      "min": 12,
      "max": 240,
      "step": 12,
      "default": 240,
      "label": "Products per page"
    }
  ],
  "presets": [
    {
      "name": "HPS Collection"
    }
  ]
}
{% endschema %}
