{%- style -%}
  #hps-newsletter-{{ section.id }} {
    --hps-newsletter-bg: {{ section.settings.bg_color }};
    --hps-newsletter-fg: {{ section.settings.text_color }};
    --hps-newsletter-btn-bg: {{ section.settings.btn_bg_color }};
    --hps-newsletter-btn-fg: {{ section.settings.btn_text_color }};
    --hps-newsletter-padding-y: {{ section.settings.padding_y }}px;
    --hps-newsletter-max-width: {{ section.settings.max_width }}px;
  }
{%- endstyle -%}

<section
  id="hps-newsletter-{{ section.id }}"
  class="hps-newsletter"
  aria-labelledby="hps-newsletter-heading-{{ section.id }}"
>
  <div class="hps-newsletter__inner">
    <div class="hps-newsletter__strip">
      <div class="hps-newsletter__head">
        <span id="hps-newsletter-heading-{{ section.id }}" class="hps-newsletter__label">
          {{ section.settings.heading | default: 'mailing list' }}
        </span>
        {%- if section.settings.tag_text != blank -%}
          <small class="hps-newsletter__tag">{{ section.settings.tag_text }}</small>
        {%- endif -%}
      </div>

      <hr class="hps-newsletter__rule">

      {%- form 'customer', class: 'hps-newsletter__form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <div class="hps-newsletter__row">
          <label class="visually-hidden" for="hps-newsletter-email-{{ section.id }}">
            {{ section.settings.email_placeholder | default: 'email' }}
          </label>
          <input
            id="hps-newsletter-email-{{ section.id }}"
            type="email"
            name="contact[email]"
            class="hps-newsletter__input"
            value="{{ form.email }}"
            placeholder="{{ section.settings.email_placeholder | default: 'email' }}"
            autocomplete="email"
            autocorrect="off"
            autocapitalize="off"
            required
            aria-required="true"
            {%- if form.errors %} aria-invalid="true" aria-describedby="hps-newsletter-error-{{ section.id }}"{% endif -%}
            {%- if form.posted_successfully? %} aria-describedby="hps-newsletter-success-{{ section.id }}"{% endif -%}
          >
          <button type="submit" name="commit" class="hps-newsletter__btn">
            {{ section.settings.button_label | default: 'add me' }}
          </button>
        </div>

        {%- if form.errors -%}
          <p
            id="hps-newsletter-error-{{ section.id }}"
            class="hps-newsletter__msg hps-newsletter__msg--error"
            role="alert"
          >
            {{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}
          </p>
        {%- endif -%}

        {%- if form.posted_successfully? -%}
          <p
            id="hps-newsletter-success-{{ section.id }}"
            class="hps-newsletter__msg hps-newsletter__msg--success"
            role="status"
          >
            {{ section.settings.success_message | default: 'thanks — you’re on the list.' }}
          </p>
        {%- endif -%}
      {%- endform -%}

      {%- if section.settings.fineprint != blank -%}
        <div class="hps-newsletter__foot">
          <span>{{ section.settings.fineprint }}</span>
          <span aria-hidden="true">·</span>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .hps-newsletter {
    width: 100%;
    background: var(--hps-newsletter-bg, #ffffff);
    color: var(--hps-newsletter-fg, #000000);
    padding: var(--hps-newsletter-padding-y, 72px) 20px;
    box-sizing: border-box;
  }

  .hps-newsletter__inner {
    width: 100%;
    max-width: var(--hps-newsletter-max-width, 480px);
    margin: 0 auto;
  }

  .hps-newsletter__strip {
    border: 1px solid currentColor;
    padding: 14px 16px 16px;
  }

  .hps-newsletter__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .hps-newsletter__label {
    flex: 1;
  }

  .hps-newsletter__tag {
    font-size: 8px;
    font-weight: 400;
    letter-spacing: 0.1em;
    opacity: 0.6;
  }

  .hps-newsletter__rule {
    border: none;
    border-top: 1px dashed currentColor;
    margin: 8px 0 10px;
  }

  .hps-newsletter__form {
    margin: 0;
  }

  .hps-newsletter__row {
    display: flex;
    gap: 8px;
  }

  .hps-newsletter__input {
    flex: 1;
    min-width: 0;
    font-family: inherit;
    font-size: 11px;
    background: transparent;
    border: 1px solid currentColor;
    outline: none;
    color: inherit;
    padding: 9px 12px;
    text-transform: lowercase;
    letter-spacing: -0.02em;
    box-sizing: border-box;
    border-radius: 0;
    appearance: none;
    -webkit-appearance: none;
  }

  .hps-newsletter__input::placeholder {
    color: inherit;
    opacity: 0.45;
  }

  .hps-newsletter__input:focus {
    outline: 1px solid currentColor;
    outline-offset: -2px;
  }

  .hps-newsletter__btn {
    font-family: inherit;
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    background: var(--hps-newsletter-btn-bg, #000000);
    color: var(--hps-newsletter-btn-fg, #ffffff);
    border: 1px solid var(--hps-newsletter-btn-bg, #000000);
    cursor: pointer;
    padding: 0 18px;
    min-width: 100px;
    height: auto;
    line-height: 1;
    transition: background 0.15s ease, color 0.15s ease;
  }

  .hps-newsletter__btn:hover {
    background: var(--hps-newsletter-btn-fg, #ffffff);
    color: var(--hps-newsletter-btn-bg, #000000);
  }

  .hps-newsletter__msg {
    margin: 10px 0 0;
    font-size: 10px;
    text-transform: lowercase;
    letter-spacing: -0.02em;
    line-height: 1.4;
  }

  .hps-newsletter__msg--error {
    color: #c00;
  }

  .hps-newsletter__msg--success {
    color: inherit;
    font-weight: 700;
  }

  .hps-newsletter__foot {
    display: flex;
    justify-content: space-between;
    font-size: 9px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin: 10px 0 0;
    opacity: 0.6;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 599px) {
    .hps-newsletter {
      padding-left: 16px;
      padding-right: 16px;
    }

    .hps-newsletter__row {
      flex-direction: column;
      gap: 8px;
    }

    .hps-newsletter__btn {
      padding: 10px 18px;
      min-width: 0;
      width: 100%;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "HPS Newsletter",
  "tag": "section",
  "class": "hps-newsletter-section",
  "settings": [
    {
      "type": "header",
      "content": "Copy"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "mailing list"
    },
    {
      "type": "text",
      "id": "tag_text",
      "label": "Side tag (small, top-right)",
      "default": "hps",
      "info": "Tiny label aligned with the heading. Leave blank to hide."
    },
    {
      "type": "text",
      "id": "email_placeholder",
      "label": "Email input placeholder",
      "default": "email"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "add me"
    },
    {
      "type": "text",
      "id": "fineprint",
      "label": "Fineprint (bottom row)",
      "default": "unsubscribe anytime",
      "info": "Small UPPERCASE note at the bottom. Leave blank to hide."
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success message",
      "default": "thanks — you’re on the list."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "padding_y",
      "label": "Vertical padding",
      "min": 24,
      "max": 200,
      "step": 4,
      "default": 72,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Strip max width",
      "min": 320,
      "max": 800,
      "step": 20,
      "default": 480,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text & border",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "btn_bg_color",
      "label": "Button background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "btn_text_color",
      "label": "Button text",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "HPS Newsletter"
    }
  ]
}
{% endschema %}
