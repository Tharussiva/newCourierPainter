{%- comment -%}
  HPS Sidebar Snippet — House Painting Service
  Parameters:
    - menu: link_list handle (required)
  Note: logo is rendered in the section header, not here.
{%- endcomment -%}

<aside class="hps-sidebar">

  {%- if request.page_type == 'product' -%}
    <a href="{{ routes.collections_url }}/all" class="hps-sidebar-keep-shopping">
      <svg class="hps-sidebar-keep-shopping__icon" viewBox="0 0 14 14" width="10" height="10" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true">
        <path d="M10 2 L4 7 L10 12" />
      </svg>
      <span>keep shopping</span>
    </a>
  {%- endif -%}

  {%- assign nav_menu = linklists[menu] -%}
  {%- if request.page_type != 'product' and request.page_type != 'page' and nav_menu.links.size > 0 -%}
    {%- assign active_link_title = 'all' -%}
    {%- for link in nav_menu.links -%}
      {%- if link.active -%}{%- assign active_link_title = link.title -%}{%- endif -%}
    {%- endfor -%}
    <details class="hps-nav-dropdown">
      <summary class="hps-nav-dropdown__summary">
        <span class="hps-nav-dropdown__label">{{ active_link_title | downcase }}</span>
        <span class="hps-nav-dropdown__chevron" aria-hidden="true">
          <svg viewBox="0 0 8 6" width="8" height="6" fill="currentColor">
            <path d="M0 0 L8 0 L4 6 Z" />
          </svg>
        </span>
      </summary>
      <nav class="hps-nav" aria-label="Category navigation">
        {%- for link in nav_menu.links -%}
          <a
            href="{{ link.url }}"
            class="hps-nav__link{% if link.active %} hps-nav__link--active{% endif %}"
          >
            {{- link.title -}}
          </a>
        {%- endfor -%}
        {%- assign _nav_remainder = nav_menu.links.size | modulo: 2 -%}
        {%- if _nav_remainder != 0 -%}
          <span class="hps-nav__filler" aria-hidden="true"></span>
        {%- endif -%}
      </nav>
    </details>
  {%- endif -%}

  <div class="hps-sidebar-cart{% if cart.item_count == 0 %} hps-sidebar-cart--empty{% endif %}">
    <div class="hps-sidebar-cart__head">
      <span>cart</span>
      <span>&times;<span class="hps-cart-count">{{ cart.item_count }}</span></span>
    </div>
    <hr class="hps-sidebar-cart__rule">
    <ul class="hps-sidebar-cart__rows" data-hps-cart-rows>
      {%- for item in cart.items -%}
        <li>
          <small class="hps-sidebar-cart__row-title">
            <span class="hps-sidebar-cart__row-qty">{{ item.quantity }}x</span>
            {{ item.product.title | downcase }}
          </small>
        </li>
      {%- endfor -%}
    </ul>
    <p class="hps-sidebar-cart__empty">cart empty</p>
    <hr class="hps-sidebar-cart__rule">
    <div class="hps-sidebar-cart__total">
      <span>subtotal</span>
      <span class="hps-cart-total">{{ cart.total_price | money }}</span>
    </div>
    <div class="hps-sidebar-cart__btns">
      <a href="{{ routes.cart_url }}" class="hps-sidebar-cart__edit">edit</a>
      <a href="/checkout" class="hps-sidebar-cart__go">checkout</a>
    </div>
  </div>

</aside>

<script>
  (function () {
    var desktopMQ = window.matchMedia('(min-width: 1140px)');
    var syncNav = function () {
      document.querySelectorAll('.hps-nav-dropdown').forEach(function (d) {
        if (desktopMQ.matches) d.setAttribute('open', '');
        else d.removeAttribute('open');
      });
    };
    syncNav();
    desktopMQ.addEventListener('change', syncNav);

    function formatMoney(cents) {
      return window.Shopify && Shopify.formatMoney
        ? Shopify.formatMoney(cents, window.moneyFormat || '{{amount}}')
        : (cents / 100).toFixed(2);
    }

    function applyCart(cart) {
      if (!cart) return;

      document.querySelectorAll('.hps-cart-count').forEach(function (el) {
        el.textContent = cart.item_count;
      });

      document.querySelectorAll('.hps-cart-total').forEach(function (el) {
        el.textContent = formatMoney(cart.total_price);
      });

      document.querySelectorAll('[data-hps-cart-rows]').forEach(function (list) {
        list.innerHTML = (cart.items || []).map(function (item) {
          var title = (item.product_title || item.title || '').toLowerCase();
          var qty = item.quantity || 1;
          return '<li><small class="hps-sidebar-cart__row-title">' +
            '<span class="hps-sidebar-cart__row-qty">' + qty + 'x</span> ' +
            title + '</small></li>';
        }).join('');
      });

      document.querySelectorAll('.hps-sidebar-cart').forEach(function (el) {
        el.classList.toggle('hps-sidebar-cart--empty', cart.item_count === 0);
      });
    }

    function onCartUpdate(event) {
      // cart-update event payloads vary (line item vs full cart), so always
      // fetch the authoritative cart state.
      fetch('/cart.js', { headers: { Accept: 'application/json' } })
        .then(function (r) { return r.json(); })
        .then(applyCart)
        .catch(function () {});
    }

    if (typeof subscribe === 'function') {
      subscribe('cart-update', onCartUpdate);
    } else {
      document.addEventListener('DOMContentLoaded', function () {
        if (typeof subscribe === 'function') subscribe('cart-update', onCartUpdate);
      });
    }

    // Reconcile sidebar against the live cart on every page load —
    // server-rendered HTML can be stale (prefetch / bfcache / CDN).
    onCartUpdate();

    // Re-sync when the page is restored from the back-forward cache.
    window.addEventListener('pageshow', function (e) {
      if (e.persisted) onCartUpdate();
    });
  })();
</script>
